(highway=primary|highway=primary_link) {name '${ref}'|'${old_ref}'|'route'} [0x03 resolution 16-17 continue]
(highway=primary|highway=primary_link) & bridge!=* {name '${ref}'|'${old_ref}'|'route'} [0x11f01 resolution 18-23 continue]
(highway=primary|highway=primary_link) & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x11f10 resolution 24]

(highway=trunk|highway=trunk_link) {name '${ref} ${name}'|'${ref}'} [0x02 resolution 15-17 continue]
