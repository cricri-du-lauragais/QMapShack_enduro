(highway=motorway|highway=motorway_link) {name '${ref} ${name}'|'${ref}'} [0x01 resolution 13-17 continue] # 0x01
(highway=motorway|highway=motorway_link) & bridge!=* {name '${ref} ${name}'|'${ref}'} [0x11d00 resolution 18]

