
## declassement route etroite
(highway=tertiary | highway=secondary) & width<5 {name '${name} ${ref} "route étroite !"'|'${ref} "route étroite !"'}
(highway=tertiary | highway=secondary | highway=primary) & (smoothness=intermediate|smoothness=bad) {name '${name} ${ref} "route pourrie !"'|'${ref} "route pourrie !"'}
(highway=tertiary | highway=secondary | highway=primary) & (smoothness=excellent|smoothness=good) {name '${name} ${ref} "billard :)"'|'${ref} "billard :)"'}

highway=raceway {name 'circuit ${sport}'|'circuit'} [0x12d05 resolution 22 ]

## roads
highway=construction {name '${name} ${ref} en construction'|'${name} en construction' |'${ref} en construction'} [0x11f13 default_name="en construction" resolution 23]

highway=bridleway {name 'cavalier-${name}' } [0x16 default_name="cavalier" resolution 23-23 continue]
highway=bridleway {name 'cavalier-${name}' } [0x12d1e resolution 24]

abandoned:highway=* [0x10906 default_name="ancienne route" resolution 23]
highway=disused [0x10906 default_name="ancienne route" resolution 23]

(highway=primary|highway=secondary|highway=tertiary|highway=unclassified|highway=residential|highway=living_street|highway=service) & oneway=yes & tunnel!=yes & length ()>75 {name "sens unique" } [0x10904 resolution 24 continue]

(highway=living_street|area:highway=living_street) {name '${name} ${ref}'|'${name}'|'${ref}'|'rue'} [0x07 resolution 22-22 continue]
(highway=living_street|area:highway=living_street) {name '${name} ${ref}'|'${name}'|'${ref}'|'rue'} [0x12d1f resolution 23-23 continue]
(highway=living_street|area:highway=living_street) {name '${name} ${ref}'|'${name}'|'${ref}'|'rue'} [0x11f06 resolution 24 ]

(highway=residential|area:highway=residential) {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x07 resolution 21-21 continue]
(highway=residential|area:highway=residential) {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x06 resolution 22-22 continue]
highway=residential & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x12d1f resolution 23-23 continue]
highway=residential & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x11f06 resolution 24 ]

highway=service & mkgmap:residential!=* [0x11f09 default_name="voie acces" resolution 21-21 continue]

highway=service & bridge!=* & (surface=paved|surface=asphalt|tracktype=grade1) {name '${name} "goudronné"'|'"goudronné"'}[0x06 resolution 22-23 continue]
highway=service & bridge!=* & (surface=paved|surface=asphalt|tracktype=grade1) {name '${name} "goudronné"'|'"goudronné"'}[0x11f06 resolution 24]

(highway=service|area:highway=service) [0x10c06 default_name="voie acces" resolution 22-23 continue] #trait continu dessous
highway=service & bridge!=* [0x10c07 default_name="voie acces" resolution 22-23 continue] #pointillés au dessus sauf !=
highway=service & bridge!=* {name '${name} "voie acces"'} [0x12d18 resolution 24 continue] #trait continu dessous
highway=service & bridge!=* [0x12d19 resolution 24] # pointillés au dessus

highway=minor {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x06 resolution 21-22 continue ]
highway=minor & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x12d1f resolution 23-23 continue ]
highway=minor & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x11f06 resolution 24 ]

highway=unclassified {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x06 resolution 20-22 continue ]
highway=unclassified {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x12d1f resolution 23-23 continue ]
highway=unclassified & bridge!=* {name '${name} ${ref}'|'${name}'|'${ref}'|'route'} [0x11f06 resolution 24 ]

(highway=tertiary|highway=tertiary_link) {name '${ref}'|'${old_ref}'|'route'} [0x05 resolution 19-20 continue ]
(highway=tertiary|highway=tertiary_link) {name '${ref}'|'${old_ref}'|'route'} [0x11f04 resolution 21-23 continue ]
