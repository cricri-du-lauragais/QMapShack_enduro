## highway=* & area=yes {delete highway}

## pont
footway=sidewalk {delete bridge}
#(highway=cycleway|railway=tram) {delete bridge}
#(highway=path|highway=footway) & surface=asphalt {delete bridge}
#highway=footway & bicycle=designated {delete bridge}
(highway=*|railway=*) & bridge=* [0x10e04 resolution 23 continue]

(highway=path|highway=footway) & (bridge=yes|bridge=viaduct) {name 'pont'} [0x12002 resolution 24 continue]
(highway=path|highway=footway) & (bridge=yes|bridge=viaduct) {name 'pont'} [0x12003 resolution 24 continue]
highway=track & (chemin=chemin_terre|chemin=chemin_exploitation|chemin=chemin_inconnu) & (bridge=yes|bridge=viaduct) {name 'pont'} [0x12002 resolution 23 continue]
