highway=track & (chemin=carrossable|chemin=piste) & (bridge=yes|bridge=viaduct) {name 'pont'} [0x11f15 resolution 23 continue]
highway=track & (chemin=carrossable|chemin=piste) & (bridge=yes|bridge=viaduct) {name 'pont'} [0x11f1c resolution 23 continue]

## escalier routable pour piéton
highway=steps [0x13 default_name="escalier" resolution 24]

highway=* & trail_visibility=no {name 
'${name}, sentier / ${note} invisible'|
'${name}, sentier invisible'|
'sentier ${note} invisible'|
'sentier invisible'
} 
[0x11f19 default_name="invisible" resolution 23]
disused:highway=* {name 
'${name}, ${note} existe plus'|
'${name} existe plus'|
'${note} existe plus'
} 
[0x11f19  default_name="existe plus" resolution 23]

## sentiers
highway=path {name 
'${name}, sentier / ${note}'|
'${name}, sentier'|
'sentier ${note}'|
'sentier'
}

highway=path & is_in(leisure,park,all)=true [0x11002 default_name="sentier" resolution 24]
highway=path & is_in(landuse,residential,all)=true [0x11002 default_name="sentier" resolution 24]
highway=path {name '${name}, ${chemin}'|'${chemin}'} [0x16 resolution 22-23 continue]
highway=path {name '${name}, ${chemin}'|'${chemin}'} [0x12d1e resolution 24]

(highway=footway|highway=pedestrian) & (location=roof|level='-1'|tunnel=building_passage)  {deletealltags}
highway=footway & footway=sidewalk  {deletealltags}
highway=footway & is_in(leisure,park,all)=true [0x11002 default_name="sentier" resolution 24]
highway=footway & is_in(landuse,residential,all)=true [0x11002 default_name="piéton" resolution 24]
highway=footway [0x16 default_name="piéton" resolution 23-23 continue]
highway=footway [0x12d1e default_name="piéton" resolution 24]

highway=pedestrian & (area!=yes|is_closed()=false|mkgmap:mp_created=false) [0x0e default_name="pedestre" resolution 24 ]

