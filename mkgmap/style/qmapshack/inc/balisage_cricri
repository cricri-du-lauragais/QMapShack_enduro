
##BALISAGES
#itineraire VTT {name 'VTT: ${VTT}'}
highway=* & mtb=mtb {name 'VTT ${colour}: ${mtbname}'|'VTT: ${mtbname}'} [0x11f11 resolution 22 continue]
highway=* & route=mtb {name 'balisé VTT'} [0x11f11 resolution 22 continue]

#sentiers balises (PR et autres) {name 'PR:${PR}'}
highway=* & pr=pr {name 'PR: ${prname}'|'PR: ${from}-${to}'} [0x10e02 resolution 22 continue]


#sentiers GRP {name 'GRP: ${GR}'}
highway=* & grp=grp {name 'GRP: ${grpname}'|'GRP: ${from}-${to}'} [0x10e01 resolution 22 continue]

#sentiers GR  {name 'GR: ${GR}'}
highway=* & gr=gr {name 'GR: ${ref} ${grname}'|'GR: ${ref}'|'GR: ${grname}'|'GR: ${from}-${to}'} [0x10e01 resolution 21 continue]

(highway=track|highway=path|highway=service|highway=footway) & (hiking=test|hiking=yes|route=hiking) & (network!=*) {name 'balisé PR'} [0x10e02 resolution 22 continue]

